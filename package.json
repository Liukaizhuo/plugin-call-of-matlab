{
  "name": "dsh-matlab-simulink",
  "version": "1.0.0",
  "description": "DeepSeek Harness plugin that drives a locally installed MATLAB/Simulink: run .m scripts and inline code, simulate .slx models with block-parameter overrides, and export publication-quality figures into the conversation.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "cordis",
    "matlab",
    "simulink",
    "simulation",
    "control-systems",
    "scientific-computing"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "os": [
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "files": [
    "lib",
    "types",
    "tools",
    "test",
    "docs",
    "cordis.patch.yml",
    "dsh-plugin.json",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/harness.mjs",
    "test:offline": "node test/harness.mjs --offline",
    "test:strict": "node test/harness.mjs --strict",
    "sync:profile": "node tools/sync-to-profile.mjs",
    "check:profile": "node tools/sync-to-profile.mjs --check",
    "pack:check": "node tools/pack-check.mjs",
    "release:build": "node tools/pack-check.mjs --build && node tools/make-source-zip.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh": "^0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Liukaizhuo/plugin-call-of-matlab.git"
  },
  "homepage": "https://github.com/Liukaizhuo/plugin-call-of-matlab#readme",
  "bugs": {
    "url": "https://github.com/Liukaizhuo/plugin-call-of-matlab/issues"
  },
  "author": "Liukaizhuo",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
